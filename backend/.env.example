# --- Вариант 1: один поставщик «Автоконтинент» -------------------------------
# Достаточно вписать логин и пароль — код менять не нужно.
# Пока они пустые, шлюз работает на демо-данных и честно сообщает об этом
# в /api/health (live_suppliers = 0).
AK_LOGIN=
AK_PASSWORD=
AK_BASE_URL=http://api.autokontinent.ru/v1
AK_ENABLED=true
AK_TIMEOUT=15
# true — принудительно демо-режим даже при заданных кредах, false — только боевой API
# AK_USE_FIXTURES=

# --- Вариант 2: несколько поставщиков ----------------------------------------
# Перекрывает переменные AK_*. Пароли держим в отдельных переменных
# окружения и подставляем через ${...}.
# SUPPLIERS_FILE=./suppliers.json
# SUPPLIERS=[{"code":"ak","type":"autokontinent","name":"Автоконтинент","login":"${AK_LOGIN}","password":"${AK_PASSWORD}"}]

# --- Шлюз ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Кэш проценки: остатки живут недолго, держим TTL маленьким
SEARCH_CACHE_TTL=60
SEARCH_CACHE_SIZE=512
# Сколько ждём медленного поставщика, прежде чем отдать выдачу без него
SUPPLIER_FANOUT_TIMEOUT=20
